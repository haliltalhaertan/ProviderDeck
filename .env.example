# Copy to `.env` in the project root (or in $PROVIDERDECK_HOME / ~/.config/providerdeck)
# and fill in only the providers you actually use. Leave unused keys commented out.
# ProviderDeck is strictly read-only: it never mutates credentials, refreshes OAuth pools,
# or makes paid inference requests during refresh.

# --- API Wallets & Gateways ---
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# NVIDIA_API_KEY=
# NOUS_API_KEY=
# ANTHROPIC_API_KEY=
# MODEL_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENCODE_ZEN_API_KEY=
# COPILOT_GITHUB_TOKEN=
# OUTRUN_API_KEY=
# UBERLLM_API_KEY=
# REFUSELESS_API_KEY=
# ORCAROUTER_API_KEY=
# VENICE_API_KEY=
# VOIDAI_API_KEY=
# EXPLABS_API_KEY=
# NANOGPT_API_KEY=

# --- Optional Local CLI & Path Overrides ---
# PROVIDERDECK_HOME=
# PROVIDERDECK_DATA_DIR=
# PROVIDERDECK_PYTHON=
# AGY_BIN=
# MUSE_WSL_DISTRO=Ubuntu
